# Supabase — cross-device sync (optional).
# Copy this file to `.env.local` and fill in your project's values.
# Without these, the app runs exactly as before: fully offline, no accounts.
#
# Find both values in your Supabase dashboard: Project Settings → API.
# The anon/publishable key is safe to expose in frontend code (it is governed
# by Row-Level Security) — but keep it in .env.local, never hardcoded.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
